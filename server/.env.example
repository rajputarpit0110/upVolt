# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/upvolt?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend & CORS
FRONTEND_URL=http://localhost:5173

# WhatsApp & Contact Integration
WHATSAPP_NUMBER=919876543210
MENTOR_DEFAULT_WHATSAPP=919876543210
MENTOR_DEFAULT_LINKEDIN=https://linkedin.com/in/yourprofile
MENTOR_DEFAULT_INSTAGRAM=https://instagram.com/yourprofile
MENTOR_DEFAULT_GITHUB=https://github.com/yourprofile

# Master Administrator Seed / Fallback
ADMIN_MASTER_USERNAME=admin
ADMIN_MASTER_EMAIL=admin@upvolt.in
ADMIN_MASTER_PASSWORD=YourSecureAdminPassword123!

# Razorpay Payment Gateway (Test or Live Keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Render / Deployment Keep-Alive URL (optional)
RENDER_EXTERNAL_URL=https://your-upvolt-backend.onrender.com

# Brevo Transactional Email (OTP Authentication)
# Set your Brevo API key in your Render Environment Variables / server .env
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@upvolt.site
BREVO_SENDER_NAME=upVolt

